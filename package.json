{
  "name": "postgresdb-mcp",
  "version": "2.1.0",
  "description": "MCP server for multi-environment PostgreSQL database access",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "postgresdb-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "prepare": "npm run build",
    "test": "echo \"No tests configured\" && exit 0"
  },
  "keywords": [
    "mcp",
    "postgresql",
    "postgres",
    "database",
    "model-context-protocol",
    "ai",
    "llm"
  ],
  "author": "Ala Eddine Khefifi",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.2"
  }
}
