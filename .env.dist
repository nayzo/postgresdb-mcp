# Environment variables template for postgresdb-mcp
# Copy this file to .env and fill in your credentials
# Note: the MCP server uses config.json (see config.example.json), not .env directly.
# This file is provided as a reference for the fields you need to configure.

# Local environment
POSTGRES_LOCAL_HOST=localhost
POSTGRES_LOCAL_PORT=5432
POSTGRES_LOCAL_DATABASE=mydb
POSTGRES_LOCAL_USER=postgres
POSTGRES_LOCAL_PASSWORD=postgres

# Test environment
POSTGRES_TST_HOST=your-test-cluster.cluster-xxxx.region.rds.amazonaws.com
POSTGRES_TST_PORT=5432
POSTGRES_TST_DATABASE=tst_mydb
POSTGRES_TST_USER=tst_user
POSTGRES_TST_PASSWORD=your-test-password

# Staging environment
POSTGRES_STG_HOST=your-staging-cluster.cluster-xxxx.region.rds.amazonaws.com
POSTGRES_STG_PORT=5432
POSTGRES_STG_DATABASE=stg_mydb
POSTGRES_STG_USER=stg_user
POSTGRES_STG_PASSWORD=your-staging-password

# Pre-production environment
POSTGRES_PREPROD_HOST=your-preprod-cluster.cluster-xxxx.region.rds.amazonaws.com
POSTGRES_PREPROD_PORT=5432
POSTGRES_PREPROD_DATABASE=preprod_mydb
POSTGRES_PREPROD_USER=preprod_user
POSTGRES_PREPROD_PASSWORD=your-preprod-password

# Production environment
POSTGRES_PROD_HOST=your-prod-cluster.cluster-xxxx.region.rds.amazonaws.com
POSTGRES_PROD_PORT=5432
POSTGRES_PROD_DATABASE=prod_mydb
POSTGRES_PROD_USER=prod_user
POSTGRES_PROD_PASSWORD=your-prod-password
