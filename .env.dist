# postgresdb-mcp — environment configuration template
# Copy this file to .env and fill in your credentials
# .env is gitignored; this file (.env.dist) is the safe template to commit

# Environments are auto-discovered: any POSTGRES_{ENV}_HOST variable defines an environment.
# The order of environments in this file is preserved in the list-environments tool.

# ── Local ────────────────────────────────────────────────────────────────────
POSTGRES_LOCAL_HOST=localhost
POSTGRES_LOCAL_PORT=5432
POSTGRES_LOCAL_DATABASE=mydb
POSTGRES_LOCAL_USER=postgres
POSTGRES_LOCAL_PASSWORD=postgres
# POSTGRES_LOCAL_SCHEMA=public

# ── Test ─────────────────────────────────────────────────────────────────────
POSTGRES_TST_HOST=your-env-host
POSTGRES_TST_PORT=5432
POSTGRES_TST_DATABASE=tst_mydb
POSTGRES_TST_USER=tst_user
POSTGRES_TST_PASSWORD=your-tst-password
POSTGRES_TST_SSL=true
POSTGRES_TST_SSL_REJECT_UNAUTHORIZED=false

# ── Staging ──────────────────────────────────────────────────────────────────
POSTGRES_STG_HOST=your-env-host
POSTGRES_STG_PORT=5432
POSTGRES_STG_DATABASE=stg_mydb
POSTGRES_STG_USER=stg_user
POSTGRES_STG_PASSWORD=your-stg-password
POSTGRES_STG_SSL=true
POSTGRES_STG_SSL_REJECT_UNAUTHORIZED=false

# ── Pre-production ────────────────────────────────────────────────────────────
POSTGRES_PREPROD_HOST=your-env-host
POSTGRES_PREPROD_PORT=5432
POSTGRES_PREPROD_DATABASE=preprod_mydb
POSTGRES_PREPROD_USER=preprod_user
POSTGRES_PREPROD_PASSWORD=your-preprod-password
POSTGRES_PREPROD_SSL=true
POSTGRES_PREPROD_PROTECTED=true

# ── Production ───────────────────────────────────────────────────────────────
POSTGRES_PROD_HOST=your-env-host
POSTGRES_PROD_PORT=5432
POSTGRES_PROD_DATABASE=prod_mydb
POSTGRES_PROD_USER=prod_user
POSTGRES_PROD_PASSWORD=your-prod-password
POSTGRES_PROD_SSL=true
POSTGRES_PROD_PROTECTED=true
